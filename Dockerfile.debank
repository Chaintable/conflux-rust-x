# bookworm: the bullseye apt repositories moved to archive.debian.org. The
# toolchain itself comes from rust-toolchain.toml.
FROM rust:1.94-bookworm AS build-env

# Set working directory for the build
WORKDIR /root/conflux

RUN apt-get update && apt-get install -y clang libsqlite3-dev pkg-config libssl-dev cmake 

# Add source files
COPY . .

RUN rustup show && cargo build --release

# Same glibc as the build image. ca-certificates for the S3 uploads of the
# debank pipeline.
FROM debian:bookworm-slim

RUN apt-get update && apt-get -y install --no-install-recommends libssl3 libsqlite3-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# FROM alpine:3.13
WORKDIR /root
# Add the config files
ADD run run
# Move to bin directory
COPY --from=build-env /root/conflux/target/release/conflux /bin/conflux

# Prepare config
COPY prepare-config.sh /root/prepare-config.sh
RUN chmod +x /root/prepare-config.sh
RUN sh /root/prepare-config.sh

WORKDIR /root/run
ENTRYPOINT [ "/bin/conflux", "--config", "conflux.toml" ]